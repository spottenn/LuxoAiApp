# API Keys for LuxoAI services
# Rename this file to .env and fill in your actual API keys.
# Do NOT commit the .env file to version control.

# For Large Language Model (LLM) access
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# For Vision Model (e.g., Grounding DINO) access via Replicate
REPLICATE_API_TOKEN=YOUR_REPLICATE_API_TOKEN_HERE

# Add other secrets as needed, for example:
# MY_SERVICE_API_KEY=YOUR_MY_SERVICE_API_KEY_HERE
