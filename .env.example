# This file is an example of the environment variables needed by the application.
# Copy this file to .env (which is gitignored) and fill in your actual values.
# These variables are used for local development outside of the Android app directly
# (e.g., if running Python scripts from Mobile-Agent-E that need API keys)
# and can also serve as a reference for what needs to be set in other environments
# like CI or the Jules VM startup script.

# For the Android application itself (LuxoAI), secrets are typically managed
# via local.properties (gitignored) or environment variables passed to Gradle.
# See resources/SECRETS.md for more details.

OPENAI_API_KEY="YOUR_OPENAI_KEY_HERE"
REPLICATE_API_TOKEN="YOUR_REPLICATE_TOKEN_HERE"

# Add any other required API keys or configuration parameters below:
# ANOTHER_SERVICE_API_KEY="YOUR_ANOTHER_SERVICE_KEY_HERE"
# SOME_CONFIG_VALUE="default_value"
